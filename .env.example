# =================================================================
# ⚙️ GAIA NAS STORAGE ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# --- STORAGE CONFIGURATION ---
NAS_HDD_UUID="YOUR_HDD_UUID_HERE"
NAS_MOUNT_POINT="/mnt/gaia"
NAS_FILESYSTEM_TYPE="ntfs-3g"
NAS_LINUX_USER="your_username"

# --- SAMBA NAS CONFIGURATION ---
NAS_NETBIOS_NAME="GAIANAS"
NAS_WORKGROUP="WORKGROUP"
NAS_SERVER_STRING="Gaia NAS Storage (%h)"

# --- FILEBROWSER WEB UI CONFIGURATION ---
FILEBROWSER_PORT=8088
FILEBROWSER_ADMIN_USER="admin"
FILEBROWSER_ADMIN_PASS="ChangeThisPassword123"
FILEBROWSER_DB_PATH="/etc/filebrowser/filebrowser.db"

# --- MINIDLNA MEDIA SERVER CONFIGURATION ---
MINIDLNA_PORT=8200
MINIDLNA_FRIENDLY_NAME="Gaia NAS Media Server"

# --- CLOUDFLARE TUNNEL CONFIGURATION ---
CLOUDFLARE_TUNNEL_PORT=8088
